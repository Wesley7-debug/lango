{
  "name": "lango-monorepo",
  "private": true,
  "version": "1.2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:website": "npm run dev --workspace=lango-website"
  },
  "engines": {
    "node": ">=18"
  }
}
