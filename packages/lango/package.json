{
  "name": "lango-i18n",
  "version": "1.2.1",
  "description": "Simple, customizable website translation for React. Powered by Google. Built for developers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/lango.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --out-dir dist && node ./scripts/build-css.mjs",
    "build:css": "node ./scripts/build-css.mjs",
    "dev": "tsup src/index.ts --format esm,cjs --dts --external react --watch --out-dir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "react",
    "translation",
    "i18n",
    "google-translate",
    "language-switcher"
  ],
  "author": "Lango contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wesley7-debug/lango.git"
  },
  "homepage": "https://github.com/Wesley7-debug/lango#readme"
}
